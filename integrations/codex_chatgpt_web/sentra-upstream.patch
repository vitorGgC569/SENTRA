diff --git a/launcher/tests/runtime-install-orphan.test.cjs b/launcher/tests/runtime-install-orphan.test.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..c8956be54c90b5db10cc7a5a4fc136f21680438e
--- /dev/null
+++ b/launcher/tests/runtime-install-orphan.test.cjs
@@ -0,0 +1,66 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const { recoverOrphanedRuntimeLock } = require("../electron/orphan-runtime-recovery.cjs");
+
+function fixture() {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "codex-web-gpt-orphan-"));
+  const coreHome = path.join(root, "core-home");
+  const destination = path.join(coreHome, "versions", "6.1.1-win32-x64");
+  const stateDir = path.join(coreHome, "runtime");
+  fs.mkdirSync(destination, { recursive: true });
+  fs.mkdirSync(stateDir, { recursive: true });
+  return { root, coreHome, destination, stateDir };
+}
+test("stops a verified orphan runtime daemon before replacement", () => {
+  const { root, coreHome, destination, stateDir } = fixture();
+  fs.writeFileSync(path.join(stateDir, "launcher-supervisor.json"), JSON.stringify({
+    version: 1, ownerPid: 111, daemonPid: 222, tunnelPid: null,
+    status: "ready", updatedAt: new Date().toISOString(),
+  }));
+  const alive = new Set([222]);
+  const calls = [];
+  const spawnSyncFn = (command, args) => {
+    calls.push([command, args]);
+    if (command === "powershell.exe") return {
+      status: 0,
+      stdout: JSON.stringify({
+        ExecutablePath: path.win32.join(destination, "runtime", "bun.exe"),
+        CommandLine: `"${path.win32.join(destination, "runtime", "bun.exe")}" "${path.win32.join(destination, "app", "cli.js")}" serve`,
+      }),
+    };    alive.delete(222);
+    return { status: 0 };
+  };
+  try {
+    assert.equal(recoverOrphanedRuntimeLock({
+      coreHome, destination, platform: "win32",
+      processRunningFn: pid => alive.has(pid), spawnSyncFn,
+    }), true);
+    assert.equal(alive.has(222), false);
+    assert.equal(calls.length, 2);
+  } finally {
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+});
+test("refuses an orphan PID outside the installed runtime", () => {
+  const { root, coreHome, destination, stateDir } = fixture();
+  fs.writeFileSync(path.join(stateDir, "launcher-supervisor.json"), JSON.stringify({
+    version: 1, ownerPid: 333, daemonPid: 444, tunnelPid: null,
+    status: "ready", updatedAt: new Date().toISOString(),
+  }));
+  const alive = new Set([444]);
+  const spawnSyncFn = () => ({ status: 0, stdout: JSON.stringify({
+    ExecutablePath: "C:\\Windows\\System32\\notepad.exe",
+    CommandLine: "notepad.exe serve",
+  }) });
+  try {
+    assert.throws(() => recoverOrphanedRuntimeLock({
+      coreHome, destination, platform: "win32",
+      processRunningFn: pid => alive.has(pid), spawnSyncFn,
+    }), /Refusing to stop orphan PID/);
+    assert.equal(alive.has(444), true);  } finally {
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+});
