new file mode 100644
index 0000000000000000000000000000000000000000..279279d5f11a5a5d88f4eb72a7e681b0cd6250ab
--- /dev/null
+++ b/src/adapters/chatgpt-web/generated-asset.ts
@@ -0,0 +1,71 @@
+import { createHash } from "node:crypto";
+
+export const GENERATED_ASSET_TRANSPORT = "authenticated-browser-download-v1" as const;
+export const MAX_GENERATED_IMAGE_BYTES = 8 * 1024 * 1024;
+export const MAX_GENERATED_PDF_BYTES = 20 * 1024 * 1024;
+
+export interface GeneratedAssetEvent {
+  type: "generated_asset";
+  transport: typeof GENERATED_ASSET_TRANSPORT;
+  request_id: string;
+  conversation_id: string;
+  message_id: string;
+  filename: string;
+  mime_type: "image/png" | "image/jpeg" | "application/pdf";
+  byte_length: number;
+  sha256: string;
+  data_base64: string;
+}
+
+const identifier = /^[A-Za-z0-9_-]{8,160}$/;
+const filenamePattern = /^[A-Za-z0-9][A-Za-z0-9._ -]{0,118}\.(?:png|jpe?g|pdf)$/i;
+
+export function validateGeneratedAsset(value: unknown): GeneratedAssetEvent {
+  if (!value || typeof value !== "object" || Array.isArray(value)) {
+    throw new Error("generated_asset_not_object");
+  }
+  const asset = value as Record<string, unknown>;
+  const expectedKeys = [
+    "type", "transport", "request_id", "conversation_id", "message_id", "filename",
+    "mime_type", "byte_length", "sha256", "data_base64",
+  ].sort();
+  if (Object.keys(asset).sort().join("\0") !== expectedKeys.join("\0")
+    || asset.type !== "generated_asset"
+    || asset.transport !== GENERATED_ASSET_TRANSPORT
+    || typeof asset.request_id !== "string" || !identifier.test(asset.request_id)
+    || typeof asset.conversation_id !== "string" || !identifier.test(asset.conversation_id)
+    || typeof asset.message_id !== "string" || !identifier.test(asset.message_id)
+    || typeof asset.filename !== "string" || !filenamePattern.test(asset.filename)
+    || !["image/png", "image/jpeg", "application/pdf"].includes(String(asset.mime_type))
+    || !Number.isSafeInteger(asset.byte_length) || (asset.byte_length as number) < 1
+    || typeof asset.sha256 !== "string" || !/^[a-f0-9]{64}$/.test(asset.sha256)
+    || typeof asset.data_base64 !== "string") {
+    throw new Error("generated_asset_metadata_invalid");
+  }
+  const mime = asset.mime_type as GeneratedAssetEvent["mime_type"];
+  const extension = asset.filename.toLowerCase().split(".").at(-1);
+  if ((mime === "image/png" && extension !== "png")
+    || (mime === "image/jpeg" && extension !== "jpg" && extension !== "jpeg")
+    || (mime === "application/pdf" && extension !== "pdf")) {
+    throw new Error("generated_asset_extension_mismatch");
+  }
+  const limit = mime === "application/pdf" ? MAX_GENERATED_PDF_BYTES : MAX_GENERATED_IMAGE_BYTES;
+  const encoded = asset.data_base64;
+  if (encoded.length > Math.ceil(limit / 3) * 4 || !/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(encoded)) {
+    throw new Error("generated_asset_base64_invalid");
+  }
+  const bytes = Buffer.from(encoded, "base64");
+  if (bytes.length !== asset.byte_length || bytes.length > limit || bytes.toString("base64") !== encoded) {
+    throw new Error("generated_asset_size_invalid");
+  }
+  const validSignature = mime === "image/png"
+    ? bytes.subarray(0, 8).equals(Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]))
+    : mime === "image/jpeg"
+      ? bytes.length >= 3 && bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff
+      : bytes.subarray(0, 5).equals(Buffer.from("%PDF-", "ascii"));
+  if (!validSignature) throw new Error("generated_asset_signature_invalid");
+  if (createHash("sha256").update(bytes).digest("hex") !== asset.sha256) {
+    throw new Error("generated_asset_sha256_mismatch");
+  }
+  return asset as unknown as GeneratedAssetEvent;
+}
