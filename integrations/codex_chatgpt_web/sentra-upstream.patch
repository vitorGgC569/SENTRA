+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import { createGeminiWebAdapter } from "../src/adapters/gemini-web";
+import { defaultConfig } from "../src/config";
+import { requireGeminiWebModelRoute } from "../src/gemini-web-models";
+import type { AdapterEvent, CodexParsedRequest } from "../src/types";
+
+const originalToken = process.env.OMA_RELAY_TOKEN;
+
+function parsedRequest(overrides: Partial<CodexParsedRequest> = {}): CodexParsedRequest {
+  return {
+    modelId: "gemini-web/flash",
+    context: {
+      systemPrompt: ["Be concise."],
+      messages: [{ role: "user", content: "hello", timestamp: 1 }],
+    },
+    stream: false,
+    options: {},
+    _rawBody: { model: "gemini-web/flash", input: [] },
+    ...overrides,
+  };
+}
+
+function installRelay(answer: string, inspect?: (payload: Record<string, unknown>) => void): typeof fetch {
+  let taskId = "";
+  return (async (input: RequestInfo | URL, init?: RequestInit) => {
+    const url = String(input);
+    if (url.endsWith("/jobs/submit")) {
+      const payload = JSON.parse(String(init?.body || "{}")) as Record<string, unknown>;
+      taskId = String(payload.task_id);
+      inspect?.(payload);
+      return Response.json({ job_id: "job_gemini_test" });
+    }
+    if (url.includes("/jobs/wait?")) {
+      return Response.json({
+        job_id: "job_gemini_test",
+        task_id: taskId,
+        status: "COMPLETED",
+        result: answer,
+        conversation_url: "https://gemini.google.com/app/abc_DEF-123",
+        conversation_id: "abc_DEF-123",
+      });
+    }
+    if (url.endsWith("/jobs/ack") || url.endsWith("/jobs/cancel")) {
+      return Response.json({ ok: true });
+    }
+    throw new Error("unexpected fetch " + url);
+  }) as typeof fetch;
+}
+
+describe("Gemini Web adapter", () => {
+  beforeEach(() => {
+    process.env.OMA_RELAY_TOKEN = "test-relay-token";
+  });
+
+  afterEach(() => {
+    if (originalToken === undefined) delete process.env.OMA_RELAY_TOKEN;
+    else process.env.OMA_RELAY_TOKEN = originalToken;
+  });
+
+  test("returns text and provider continuation state", async () => {
+    let submitted: Record<string, unknown> | undefined;
+    const fetchImpl = installRelay("GEMINI_OK", payload => {
+      submitted = payload;
+    });
+
+    const config = { ...defaultConfig(), geminiWebEnabled: true };
+    const route = requireGeminiWebModelRoute("gemini-web/flash", config);
+    const adapter = createGeminiWebAdapter(config, route, fetchImpl);
+    const events: AdapterEvent[] = [];
+    await adapter.runTurn(parsedRequest(), { headers: new Headers() }, event => events.push(event));
+
+    expect(submitted).toMatchObject({
+      provider: "gemini",
+      model: "flash",
+      new_chat: true,
+      conversation_url: null,
+    });
+    expect(events.find(event => event.type === "text_delta")).toMatchObject({
+      type: "text_delta",
+      text: "GEMINI_OK",
+    });
+    expect(events.at(-1)).toMatchObject({
+      type: "done",
+      stopReason: "stop",
+      endTurn: true,
+      providerState: {
+        geminiWeb: {
+          conversationUrl: "https://gemini.google.com/app/abc_DEF-123",
+          model: "flash",
+        },
+      },
+    });
+  });
+
+  test("emits validated native Codex tool calls", async () => {
+    const answer = '<SENTRA_TOOL_CALLS>{"calls":[{"name":"read_file","arguments":{"path":"README.md"}}]}</SENTRA_TOOL_CALLS>';
+    let taskId = "";
+    const fetchImpl = (async (input: RequestInfo | URL, init?: RequestInit) => {
+      const url = String(input);
+      if (url.endsWith("/jobs/submit")) {
+        const payload = JSON.parse(String(init?.body || "{}"));
+        taskId = String(payload.task_id);
+        return Response.json({ job_id: "job_tool" });
+      }
+      if (url.includes("/jobs/wait?")) {
+        return Response.json({
+          job_id: "job_tool",
+          task_id: taskId,
+          status: "COMPLETED",
+          result: answer,
+          conversation_url: "https://gemini.google.com/app/tool_123",
+          conversation_id: "tool_123",
+        });
+      }
+      if (url.endsWith("/jobs/ack")) return Response.json({ ok: true });
+      throw new Error("unexpected fetch " + url);
+    }) as typeof fetch;
+
+    const config = { ...defaultConfig(), geminiWebEnabled: true };
+    const route = requireGeminiWebModelRoute("gemini-web/flash", config);
+    const adapter = createGeminiWebAdapter(config, route, fetchImpl);
+    const request = parsedRequest({
+      context: {
+        messages: [{ role: "user", content: "read the readme", timestamp: 1 }],
+        tools: [{
+          name: "read_file",
+          description: "Read a text file",
+          parameters: {
+            type: "object",
+            properties: { path: { type: "string" } },
+            required: ["path"],
+            additionalProperties: false,
+          },
+        }],
