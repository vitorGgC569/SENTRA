+async function sentraBrowserPost(phase: string, data: Record<string, unknown>): Promise<any> {
+  const endpoint = process.env.SENTRA_TURN_AUTHORITY_URL, token = process.env.SENTRA_TURN_AUTHORITY_TOKEN;
+  if (!endpoint || !token) throw new Error('sentra_authority_unavailable');
+  const address = new URL(endpoint);
+  if (address.protocol !== 'http:' || address.hostname !== '127.0.0.1' || address.username || address.password
+    || address.pathname !== '/' || address.search || address.hash) throw new Error('sentra_authority_not_loopback');
+  const response = await fetch(`${endpoint}/internal/turn/browser-${phase}`, { method: 'POST',
+    headers: { 'content-type': 'application/json', authorization: `Bearer ${token}` },
+    body: JSON.stringify(data), redirect: 'error', signal: AbortSignal.timeout(5000) });
+  if (!response.ok) throw new Error(`sentra_${phase}_rejected:${response.status}`);
+  return await response.json();
+}
