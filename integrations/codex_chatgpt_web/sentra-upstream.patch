@@ -0,0 +1,209 @@
+import { createHash } from "node:crypto";
+import { webcrypto } from "node:crypto";
+import { runInNewContext } from "node:vm";
+import { expect, test } from "bun:test";
+import { bridgeToResponsesSSE } from "../src/bridge";
+import {
+  projectSentraCommittedMessages,
+  readSentraPageEvidence,
+  verifyNativeAssetAssistantIdentity,
+  type SentraPageEvidence,
+} from "../src/adapters/chatgpt-web/browser-worker";
+import { validateGeneratedAsset, type GeneratedAssetEvent } from "../src/adapters/chatgpt-web/generated-asset";
+import type { AdapterEvent } from "../src/types";
+
+const bytes = Buffer.concat([
+  Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]),
+  Buffer.from("fixture-png"),
+]);
+
+function validAsset(): GeneratedAssetEvent {
+  return {
+    type: "generated_asset",
+    transport: "authenticated-browser-download-v1",
+    request_id: "sentra-cli-turn-0123456789abcdef",
+    conversation_id: "conversation-0123456789",
+    message_id: "assistant-message-0123456789",
+    filename: "generated-image.png",
+    mime_type: "image/png",
+    byte_length: bytes.length,
+    sha256: createHash("sha256").update(bytes).digest("hex"),
+    data_base64: bytes.toString("base64"),
+  };
+}
+
+test("generated asset metadata, canonical bytes, type and digest are validated", () => {
+  expect(validateGeneratedAsset(validAsset())).toEqual(validAsset());
+  expect(() => validateGeneratedAsset({ ...validAsset(), filename: "../generated.png" }))
+    .toThrow("generated_asset_metadata_invalid");
+  expect(() => validateGeneratedAsset({ ...validAsset(), sha256: "0".repeat(64) }))
+    .toThrow("generated_asset_sha256_mismatch");
+  expect(() => validateGeneratedAsset({ ...validAsset(), mime_type: "image/jpeg" }))
+    .toThrow("generated_asset_extension_mismatch");
+  expect(() => validateGeneratedAsset({ ...validAsset(), data_base64: validAsset().data_base64 + " " }))
+    .toThrow("generated_asset_base64_invalid");
+  expect(() => validateGeneratedAsset({ ...validAsset(), external_url: "https://evil.invalid/a.png" }))
+    .toThrow("generated_asset_metadata_invalid");
+});
+
+test("media-only turn emits the verified custom event before a normal completed terminal", async () => {
+  async function* events(): AsyncGenerator<AdapterEvent> {
+    yield validateGeneratedAsset(validAsset());
+    yield { type: "done", endTurn: true };
+  }
+  const body = await new Response(bridgeToResponsesSSE(events(), "chatgpt-web/test")).text();
+  const custom = body.indexOf("event: sentra.generated_asset");
+  const completed = body.indexOf("event: response.completed");
+  expect(custom).toBeGreaterThanOrEqual(0);
+  expect(custom).toBeLessThan(completed);
+  expect(body).toContain('"request_id":"sentra-cli-turn-0123456789abcdef"');
+  expect(body).toContain('"conversation_id":"conversation-0123456789"');
+  expect(body).toContain('"message_id":"assistant-message-0123456789"');
+  expect(body).toContain('"data_base64":"' + bytes.toString("base64") + '"');
+  expect(body).toContain('"output":[]');
+  expect(body).toContain("data: [DONE]");
+});
+
+test("native media identity requires this submission, exact parent reply and same document", () => {
+  const prompt = "Create a blue square";
+  const promptHash = createHash("sha256").update(prompt, "utf8").digest("hex");
+  const baseline = {
+    documentId: "a".repeat(32),
+    identityEpoch: "b".repeat(32),
+    surfaceId: "owned-surface",
+    conversationId: "conversation-0123456789",
+    baselineUserMessageIds: ["old-user-message-123456"],
+    promptSha256: promptHash,
+  };
+  const current: SentraPageEvidence = {
+    document_id: baseline.documentId,
+    identity_epoch: baseline.identityEpoch,
+    surface_id: baseline.surfaceId,
+    conversation_id: baseline.conversationId,
+    state: "observed",
+    messages: [
+      { message_id: "old-user-message-123456", request_id: "old-request-123456", text: prompt },
+      { message_id: "new-user-message-123456", request_id: "new-request-123456", text: prompt },
+    ],
+    assistants: [],
+    media_messages: [{
+      message_id: "new-user-message-123456",
+      request_id: "new-request-123456",
+      text_sha256: promptHash,
+    }],
+    media_assistants: [{
+      message_id: "new-assistant-message-123456",
+      parent_id: "new-user-message-123456",
+      status: "finished_successfully",
+    }],
+  };
+  expect(verifyNativeAssetAssistantIdentity(
+    baseline, current, promptHash, ["new-assistant-message-123456"],
+  ))
+    .toEqual({ conversationId: baseline.conversationId, messageId: "new-assistant-message-123456" });
+  expect(verifyNativeAssetAssistantIdentity(baseline, current, promptHash, ["prior-assistant-message"]))
+    .toBeUndefined();
+  expect(verifyNativeAssetAssistantIdentity(baseline, {
+    ...current,
+    document_id: "c".repeat(32),
+  }, promptHash, ["new-assistant-message-123456"])).toBeUndefined();
+  expect(verifyNativeAssetAssistantIdentity(baseline, {
+    ...current,
+    media_assistants: [{
+      message_id: "new-assistant-message-123456",
+      parent_id: "different-user-message",
+      status: "finished_successfully",
+    }],
+  }, promptHash, ["new-assistant-message-123456"])).toBeUndefined();
+  expect(verifyNativeAssetAssistantIdentity(baseline, {
+    ...current,
+    media_assistants: [{ ...current.media_assistants[0]!, status: "in_progress" }],
+  }, promptHash, ["new-assistant-message-123456"])).toBeUndefined();
+});
+
+test("rich assistant media contributes identity only, never text attestation", () => {
+  const prompt = "Create a blue square";
+  const projected = projectSentraCommittedMessages([
+    {
+      id: "new-user-message-123456",
+      author: { role: "user" },
+      metadata: { request_id: "new-request-123456" },
+      content: { parts: [prompt, { content_type: "image_asset_pointer", asset_pointer: "private" }] },
+    },
+    {
+      id: "new-assistant-message-123456",
+      parent_id: "new-user-message-123456",
+      status: "finished_successfully",
+      author: { role: "assistant" },
+      content: { parts: [{ content_type: "image", url: "must-not-be-exported" }] },
+    },
+  ]);
+  expect(projected.messages).toEqual([]);
+  expect(projected.assistants).toEqual([]);
+  expect(projected.media_messages).toEqual([{
+    message_id: "new-user-message-123456",
+    request_id: "new-request-123456",
+    text_sha256: createHash("sha256").update(prompt, "utf8").digest("hex"),
+  }]);
+  expect(projected.media_assistants).toEqual([{
+    message_id: "new-assistant-message-123456",
+    parent_id: "new-user-message-123456",
+    status: "finished_successfully",
+  }]);
+  expect(JSON.stringify(projected)).not.toContain("must-not-be-exported");
+  expect(JSON.stringify(projected)).not.toContain("private");
+});
+
+test("serialized page reader projects committed rich messages without Node closures", async () => {
+  const prompt = "Create a blue square";
+  const root: Record<string, any> = { tag: 3, memoizedProps: {
+    conversationId: "conversation-0123456789",
+    messages: [
+      {
+        id: "new-user-message-123456",
+        author: { role: "user" },
+        metadata: { request_id: "new-request-123456" },
+        content: { parts: [prompt, { content_type: "image_asset_pointer", asset_pointer: "secret" }] },
+      },
+      {
+        id: "new-assistant-message-123456",
+        parent_id: "new-user-message-123456",
+        status: "finished_successfully",
+        author: { role: "assistant" },
+        content: { parts: [{ content_type: "image", url: "secret-image-url" }] },
+      },
+    ],
+  } };
+  const fiber = { tag: 5, return: root, memoizedProps: {} };
+  root.child = fiber;
+  root.stateNode = { current: root };
+  const element = { [`__reactFiber$fixture`]: fiber };
+  const sandbox = {
+    __SENTRA_WEB_DOCUMENT__: {
+      document_id: "a".repeat(32), identity_epoch: "b".repeat(32), surface_id: "owned-surface",
+    },
+    location: { origin: "https://chatgpt.com", pathname: "/c/conversation-0123456789" },
+    document: {
+      querySelectorAll: () => [element],
+      querySelector: () => null,
+    },
+    crypto: webcrypto,
+    TextEncoder,
+  };
+  const reader = runInNewContext(`(${readSentraPageEvidence.toString()})`, sandbox) as () => Promise<SentraPageEvidence>;
+  const evidence = await reader();
+  expect(evidence.assistants).toEqual([]);
+  expect(evidence.messages).toEqual([]);
+  expect(evidence.media_messages).toEqual([{
+    message_id: "new-user-message-123456",
+    request_id: "new-request-123456",
+    text_sha256: createHash("sha256").update(prompt, "utf8").digest("hex"),
+  }]);
+  expect(evidence.media_assistants).toEqual([{
+    message_id: "new-assistant-message-123456",
+    parent_id: "new-user-message-123456",
+    status: "finished_successfully",
+  }]);
+  expect(JSON.stringify(evidence)).not.toContain("secret-image-url");
+  expect(JSON.stringify(evidence)).not.toContain("secret");
+});
