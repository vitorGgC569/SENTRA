+  const catalogStarted = new Promise<void>(resolve => { markCatalogStarted = resolve; });
+  const catalogGate = new Promise<void>(resolve => { releaseCatalog = resolve; });
+  const server = startServer(config, {
+    fetchUpstream: async () => {
+      markCatalogStarted();
+      await catalogGate;
+      return Response.json({
+        models: [{
+          slug: "gpt-5.6-sol",
+          display_name: "5.6 Sol",
+          visibility: "list",
+          supported_in_api: true,
+          supported_reasoning_levels: [],
+          tool_mode: "code_mode_only",
+        }],
+      });
+    },
+  });
+  const endpoint = `http://127.0.0.1:${server.port}`;
+  try {
+    const pendingCatalog = fetch(`${endpoint}/v1/models`, {
+      headers: { authorization: "Bearer test-codex-session" },
+    });
+    await catalogStarted;
+
+    expect(await (await fetch(`${endpoint}/healthz`)).json()).toMatchObject({
+      active_http_turns: 0,
+      active_browser_turns: 0,
+    });
+
+    releaseCatalog();
+    expect((await pendingCatalog).status).toBe(200);
+  } finally {
+    releaseCatalog();
+    await server.stop(true);
+  }
+});
+
