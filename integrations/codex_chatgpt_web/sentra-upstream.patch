new file mode 100644
index 0000000000000000000000000000000000000000..90696a21ff109b07a6873f4691595a8d03dc4dda
--- /dev/null
+++ b/launcher/electron/orphan-runtime-recovery.cjs
@@ -0,0 +1,86 @@
+const fs = require("node:fs");
+const path = require("node:path");
+const { spawnSync } = require("node:child_process");
+const { processRunning } = require("./process-tree.cjs");
+
+const EXIT_TIMEOUT_MS = 5_000;
+const SYNC_WAIT = new Int32Array(new SharedArrayBuffer(4));
+
+function sleepSync(milliseconds) {
+  Atomics.wait(SYNC_WAIT, 0, 0, milliseconds);
+}
+
+function readOwnershipState(coreHome) {
+  const statePath = path.join(coreHome, "runtime", "launcher-supervisor.json");
+  if (!fs.existsSync(statePath)) return null;
+  try {
+    const state = JSON.parse(fs.readFileSync(statePath, "utf8"));
+    return state && typeof state === "object" ? state : null;
+  } catch {
+    return null;
+  }
+}
+function inspectWindowsProcess(pid, spawnSyncFn) {
+  const script =
+    "$p=Get-CimInstance Win32_Process -Filter \"ProcessId=" + pid + "\"; "
+    + "if($p){$p | Select-Object ExecutablePath,CommandLine | ConvertTo-Json -Compress}";
+  const result = spawnSyncFn(
+    "powershell.exe",
+    ["-NoProfile", "-NonInteractive", "-Command", script],
+    { encoding: "utf8", windowsHide: true, timeout: 5_000 },
+  );
+  if (result.error || result.status !== 0 || !result.stdout?.trim()) {
+    throw new Error("Could not verify orphan runtime process " + pid);
+  }
+  try {
+    return JSON.parse(result.stdout);
+  } catch {
+    throw new Error("Orphan runtime process " + pid + " returned invalid identity evidence");
+  }
+}
+function recoverOrphanedRuntimeLock({
+  coreHome, destination, platform = process.platform,
+  processRunningFn = processRunning, spawnSyncFn = spawnSync,
+}) {
+  if (platform !== "win32") return false;
+  const state = readOwnershipState(coreHome);
+  const ownerPid = state?.ownerPid;
+  const daemonPid = state?.daemonPid;
+  if (!Number.isInteger(ownerPid) || ownerPid < 1
+    || !Number.isInteger(daemonPid) || daemonPid < 1
+    || processRunningFn(ownerPid) || !processRunningFn(daemonPid)) return false;
+
+  const info = inspectWindowsProcess(daemonPid, spawnSyncFn);
+  const expected = path.win32.resolve(destination).toLowerCase();
+  const executable = typeof info?.ExecutablePath === "string"
+    ? path.win32.resolve(info.ExecutablePath).toLowerCase() : "";
+  const commandLine = typeof info?.CommandLine === "string"
+    ? info.CommandLine.toLowerCase() : "";
+  const matches = executable.startsWith(expected + "\\")
+    && commandLine.includes(expected)
+    && commandLine.includes("serve");  if (!matches) {
+    throw new Error(
+      "Refusing to stop orphan PID " + daemonPid
+      + ": process identity does not match " + destination,
+    );
+  }
+
+  const systemRoot = process.env.SystemRoot || process.env.SYSTEMROOT || "C:\\Windows";
+  const taskkill = path.win32.join(systemRoot, "System32", "taskkill.exe");
+  const stopped = spawnSyncFn(
+    taskkill, ["/PID", String(daemonPid), "/T", "/F"],
+    { stdio: "ignore", windowsHide: true, timeout: 10_000 },
+  );
+  if ((stopped.error || stopped.status !== 0) && processRunningFn(daemonPid)) {
+    throw new Error("Could not stop verified orphan runtime process " + daemonPid);
+  }
+  const deadline = Date.now() + EXIT_TIMEOUT_MS;
+  while (processRunningFn(daemonPid) && Date.now() < deadline) sleepSync(50);
+  if (processRunningFn(daemonPid)) {
+    throw new Error("Verified orphan runtime process " + daemonPid + " did not exit");
+  }
+  return true;
+}
+module.exports = {
+  recoverOrphanedRuntimeLock,
+};
