+/** Runs in the owned page, reads committed React IDs/content only, never account/session data. */
+export function readSentraPageEvidence(): SentraPageEvidence {
+  const scope = globalThis as typeof globalThis & { __SENTRA_WEB_DOCUMENT__?: SentraDocument };
+  const identity = scope.__SENTRA_WEB_DOCUMENT__;
+  if (!identity || !/^[a-f0-9]{32}$/.test(identity.document_id)
+    || !/^[a-f0-9]{32}$/.test(identity.identity_epoch) || !identity.surface_id
+    || location.origin !== 'https://chatgpt.com') throw new Error('sentra_document_unverified');
+  const id = (value: unknown): value is string => typeof value === 'string' && /^[A-Za-z0-9_-]{8,160}$/.test(value);
+  const route = /^\/c\/([A-Za-z0-9_-]{8,160})(?:\/|$)/.exec(location.pathname)?.[1] ?? null;
+  const messages = new Map<string, SentraObservedMessage>();
+  const requests = new Map<string, string>();
+  const assistants = new Map<string, { message_id: string; request_id?: string; parent_id?: string; text: string }>();
+  let conversation: string | null = null;
+  for (const element of [...document.querySelectorAll('[data-message-id],[data-turn-key],[data-turn-id-container]')].slice(-200)) {
+    // Reconstruct only the committed path, rejecting the stale React alternate.
+    const key = Object.keys(element).find(key => key.startsWith('__reactFiber$'));
+    if (!key) continue;
+    type Fiber = { tag: number; return?: Fiber; child?: Fiber; sibling?: Fiber; alternate?: Fiber;
+      stateNode?: { current?: Fiber }; memoizedProps?: Record<string, any> };
+    let node = (element as unknown as Record<string, Fiber>)[key];
+    const path: Fiber[] = [], visited = new Set<Fiber>();
+    while (node && node.tag !== 3 && path.length < 2048 && !visited.has(node)) {
+      visited.add(node); path.push(node); node = node.return!;
+    }
+    const root = node?.stateNode, current = root?.current;
+    if (!current || (current !== node && current !== node.alternate)) continue;
+    node = current;
+    const props: Record<string, any>[] = [node.memoizedProps ?? {}];
+    let valid = true, budget = 4096;
+    for (const expected of path.reverse()) {
+      let selected: Fiber | undefined;
+      for (let child = node.child; child; child = child.sibling) {
+        if (--budget < 0) { valid = false; break; }
+        if (child !== expected && child !== expected.alternate) continue;
+        if (selected) { valid = false; break; }
+        selected = child;
+      }
+      if (!valid || !selected || root!.current !== current) { valid = false; break; }
+      node = selected; props.push(node.memoizedProps ?? {});
+    }
+    if (!valid) continue;
+    let branch: string | null = null;
+    const values: any[] = [];
+    for (const p of props.slice(-80)) {
+      for (const candidate of [p.conversationId, p.clientThreadId, p.conversation?.id, p.turn?.conversationId]) {
+        if (!id(candidate)) continue;
+        if (branch && candidate !== branch) throw new Error('sentra_conversation_conflict');
+        branch = candidate;
+      }
+      for (const list of [p.messages, p.allMessages, p.turn?.messages]) if (Array.isArray(list)) values.push(...list.slice(0, 200));
+      if (p.message) values.push(p.message);
+    }
+    if (!branch) continue;
+    if ((route && branch !== route) || (conversation && conversation !== branch)) throw new Error('sentra_conversation_conflict');
+    conversation = branch;
+    for (const message of values.slice(0, 600)) {
+      if (!['user', 'assistant'].includes(message?.author?.role) || !id(message.id)) continue;
+      const parts = message.content?.parts;
+      if (!Array.isArray(parts) || parts.some(part => typeof part !== 'string')) continue;
+      const text = parts.join('\n');
+      if (text.length > 2_000_000) throw new Error('sentra_message_too_large');
+      if (message.author.role === 'assistant') {
+        const candidate = { message_id: message.id, text,
+          ...(id(message.metadata?.request_id) ? { request_id: message.metadata.request_id } : {}),
+          ...(id(message.parent_id) ? { parent_id: message.parent_id } : {}) };
+        const prior = assistants.get(message.id);
+        if (prior && JSON.stringify(prior) !== JSON.stringify(candidate)) throw new Error('sentra_assistant_conflict');
+        assistants.set(message.id, candidate);
+        continue;
+      }
+      if (!id(message.metadata?.request_id)) continue;
+      const observed = { message_id: message.id, request_id: message.metadata.request_id, text };
+      const prior = messages.get(message.id), owner = requests.get(observed.request_id);
+      if ((prior && (prior.request_id !== observed.request_id || prior.text !== text)) || (owner && owner !== message.id)) {
+        throw new Error('sentra_message_conflict');
+      }
+      messages.set(message.id, observed); requests.set(observed.request_id, message.id);
+    }
+  }
+  const approval = document.querySelector('[data-testid="connector-approval"],[data-testid="tool-approval"],[data-testid="approval-card"]');
+  return { ...identity, conversation_id: conversation ?? route,
+    state: approval ? 'awaiting_approval' : 'observed', messages: [...messages.values()], assistants: [...assistants.values()] };
+}
