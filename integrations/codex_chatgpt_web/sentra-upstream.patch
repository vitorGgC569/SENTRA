+          ...(id(message.metadata?.request_id) ? { request_id: message.metadata.request_id } : {}),
+          ...(id(message.parent_id) ? { parent_id: message.parent_id } : {}) };
+        const prior = assistants.get(message.id);
+        if (prior && JSON.stringify(prior) !== JSON.stringify(candidate)) throw new Error('sentra_assistant_conflict');
+        assistants.set(message.id, candidate);
+        continue;
+      }
+      const requestId = id(message.metadata?.request_id) ? message.metadata.request_id : undefined;
+      const media = { message_id: message.id, ...(requestId ? { request_id: requestId } : {}) };
+      const previousMedia = mediaMessages.get(message.id);
+      const previousText = userTextCandidates.get(message.id)?.text;
+      if (previousMedia && (previousMedia.request_id !== media.request_id || (previousText !== undefined && previousText !== text))) {
+        throw new Error('sentra_media_message_conflict');
+      }
+      mediaMessages.set(message.id, media);
+      userTextCandidates.set(message.id, { ...(requestId ? { requestId } : {}), text });
+      if (parts.some((part: unknown) => typeof part !== 'string') || !requestId) continue;
+      const observed = { message_id: message.id, request_id: requestId, text };
+      const prior = messages.get(message.id), owner = requests.get(requestId);
+      if ((prior && (prior.request_id !== requestId || prior.text !== text)) || (owner && owner !== message.id)) {
+        throw new Error('sentra_message_conflict');
+      }
+      messages.set(message.id, observed); requests.set(requestId, message.id);
+    }
