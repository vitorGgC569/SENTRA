--- /dev/null
+++ b/tests/gemini-web-adapter.test.ts
@@ -0,0 +1,310 @@
+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import { createGeminiWebAdapter } from "../src/adapters/gemini-web";
+import { defaultConfig } from "../src/config";
+import { requireGeminiWebModelRoute } from "../src/gemini-web-models";
+import type { AdapterEvent, CodexParsedRequest } from "../src/types";
+
+const originalToken = process.env.OMA_RELAY_TOKEN;
+
+function parsedRequest(overrides: Partial<CodexParsedRequest> = {}): CodexParsedRequest {
+  return {
+    modelId: "gemini-web/flash",
+    context: {
+      systemPrompt: ["Be concise."],
+      messages: [{ role: "user", content: "hello", timestamp: 1 }],
+    },
+    stream: false,
+    options: {},
+    _rawBody: { model: "gemini-web/flash", input: [] },
+    ...overrides,
+  };
+}
+
+function installRelay(answer: string, inspect?: (payload: Record<string, unknown>) => void): typeof fetch {
+  let taskId = "";
+  return (async (input: RequestInfo | URL, init?: RequestInit) => {
+    const url = String(input);
+    if (url.endsWith("/jobs/submit")) {
+      const payload = JSON.parse(String(init?.body || "{}")) as Record<string, unknown>;
+      taskId = String(payload.task_id);
+      inspect?.(payload);
+      return Response.json({ job_id: "job_gemini_test" });
+    }
+    if (url.includes("/jobs/wait?")) {
+      return Response.json({
+        job_id: "job_gemini_test",
+        task_id: taskId,
+        status: "COMPLETED",
+        result: answer,
+        conversation_url: "https://gemini.google.com/app/abc_DEF-123",
+        conversation_id: "abc_DEF-123",
+      });
+    }
+    if (url.endsWith("/jobs/ack") || url.endsWith("/jobs/cancel")) {
+      return Response.json({ ok: true });
+    }
+    throw new Error("unexpected fetch " + url);
+  }) as typeof fetch;
+}
+
+describe("Gemini Web adapter", () => {
+  beforeEach(() => {
+    process.env.OMA_RELAY_TOKEN = "test-relay-token";
+  });
+
+  afterEach(() => {
+    if (originalToken === undefined) delete process.env.OMA_RELAY_TOKEN;
+    else process.env.OMA_RELAY_TOKEN = originalToken;
+  });
+
+  test("returns text and provider continuation state", async () => {
+    let submitted: Record<string, unknown> | undefined;
+    const fetchImpl = installRelay("GEMINI_OK", payload => {
+      submitted = payload;
+    });
+
+    const config = { ...defaultConfig(), geminiWebEnabled: true };
+    const route = requireGeminiWebModelRoute("gemini-web/flash", config);
+    const adapter = createGeminiWebAdapter(config, route, fetchImpl);
+    const events: AdapterEvent[] = [];
+    await adapter.runTurn(parsedRequest(), { headers: new Headers() }, event => events.push(event));
+
+    expect(submitted).toMatchObject({
+      provider: "gemini",
+      model: "flash",
+      new_chat: true,
+      conversation_url: null,
+    });
+    expect(events.find(event => event.type === "text_delta")).toMatchObject({
+      type: "text_delta",
+      text: "GEMINI_OK",
+    });
+    expect(events.at(-1)).toMatchObject({
+      type: "done",
+      stopReason: "stop",
+      endTurn: true,
+      providerState: {
+        geminiWeb: {
+          conversationUrl: "https://gemini.google.com/app/abc_DEF-123",
+          model: "flash",
+        },
+      },
+    });
+  });
+
+  test("emits validated native Codex tool calls", async () => {
+    const answer = '<SENTRA_TOOL_CALLS>{"calls":[{"name":"read_file","arguments":{"path":"README.md"}}]}</SENTRA_TOOL_CALLS>';
+    let taskId = "";
+    const fetchImpl = (async (input: RequestInfo | URL, init?: RequestInit) => {
+      const url = String(input);
+      if (url.endsWith("/jobs/submit")) {
+        const payload = JSON.parse(String(init?.body || "{}"));
+        taskId = String(payload.task_id);
+        return Response.json({ job_id: "job_tool" });
+      }
+      if (url.includes("/jobs/wait?")) {
+        return Response.json({
+          job_id: "job_tool",
+          task_id: taskId,
+          status: "COMPLETED",
+          result: answer,
+          conversation_url: "https://gemini.google.com/app/tool_123",
+          conversation_id: "tool_123",
+        });
+      }
+      if (url.endsWith("/jobs/ack")) return Response.json({ ok: true });
+      throw new Error("unexpected fetch " + url);
+    }) as typeof fetch;
+
+    const config = { ...defaultConfig(), geminiWebEnabled: true };
+    const route = requireGeminiWebModelRoute("gemini-web/flash", config);
+    const adapter = createGeminiWebAdapter(config, route, fetchImpl);
+    const request = parsedRequest({
+      context: {
+        messages: [{ role: "user", content: "read the readme", timestamp: 1 }],
+        tools: [{
+          name: "read_file",
+          description: "Read a text file",
+          parameters: {
+            type: "object",
+            properties: { path: { type: "string" } },
+            required: ["path"],
+            additionalProperties: false,
+          },
+        }],
+      },
+    });
+    const events: AdapterEvent[] = [];
+    await adapter.runTurn(request, { headers: new Headers() }, event => events.push(event));
+
+    expect(events.find(event => event.type === "tool_call_start")).toMatchObject({
+      type: "tool_call_start",
+      name: "read_file",
+    });
+    expect(events.find(event => event.type === "tool_call_delta")).toMatchObject({
+      type: "tool_call_delta",
+      arguments: '{"path":"README.md"}',
+    });
+    expect(events.at(-1)).toMatchObject({
+      type: "done",
+      stopReason: "tool_use",
+      endTurn: false,
+    });
+  });
+
+  test("rejects invented tools before Codex can execute them", async () => {
+    const answer = '<SENTRA_TOOL_CALLS>{"calls":[{"name":"evil_tool","arguments":{}}]}</SENTRA_TOOL_CALLS>';
+    let taskId = "";
+    const fetchImpl = (async (input: RequestInfo | URL, init?: RequestInit) => {
+      const url = String(input);
+      if (url.endsWith("/jobs/submit")) {
+        const payload = JSON.parse(String(init?.body || "{}"));
+        taskId = String(payload.task_id);
+        return Response.json({ job_id: "job_bad_tool" });
+      }
+      if (url.includes("/jobs/wait?")) {
+        return Response.json({
+          job_id: "job_bad_tool",
+          task_id: taskId,
+          status: "COMPLETED",
+          result: answer,
+          conversation_url: "https://gemini.google.com/app/bad_123",
+          conversation_id: "bad_123",
+        });
+      }
+      if (url.endsWith("/jobs/ack")) return Response.json({ ok: true });
+      throw new Error("unexpected fetch " + url);
+    }) as typeof fetch;
+
+    const config = { ...defaultConfig(), geminiWebEnabled: true };
+    const route = requireGeminiWebModelRoute("gemini-web/flash", config);
+    const adapter = createGeminiWebAdapter(config, route, fetchImpl);
+    const request = parsedRequest({
+      context: {
+        messages: [{ role: "user", content: "do something", timestamp: 1 }],
+        tools: [{
+          name: "safe_tool",
+          description: "Only allowed tool",
+          parameters: { type: "object", additionalProperties: false },
+        }],
+      },
+    });
+
+    await expect(
+      adapter.runTurn(request, { headers: new Headers() }, () => {}),
+    ).rejects.toThrow("unavailable tool");
+  });
+
+  test("continues the exact Gemini conversation after a Codex tool result", async () => {
+    let taskId = "";
+    let submitted: Record<string, unknown> | undefined;
+    const fetchImpl = (async (input: RequestInfo | URL, init?: RequestInit) => {
+      const url = String(input);
+      if (url.endsWith("/jobs/submit")) {
+        submitted = JSON.parse(String(init?.body || "{}"));
+        taskId = String(submitted!.task_id);
+        return Response.json({ job_id: "job_follow" });
+      }
+      if (url.includes("/jobs/wait?")) {
+        return Response.json({
+          job_id: "job_follow",
+          task_id: taskId,
+          status: "COMPLETED",
+          result: "FOLLOWUP_OK",
+          conversation_url: "https://gemini.google.com/app/follow_123",
+          conversation_id: "follow_123",
+        });
+      }
+      if (url.endsWith("/jobs/ack")) return Response.json({ ok: true });
+      throw new Error("unexpected fetch " + url);
+    }) as typeof fetch;
+
+    const config = { ...defaultConfig(), geminiWebEnabled: true };
+    const route = requireGeminiWebModelRoute("gemini-web/pro", config);
+    const adapter = createGeminiWebAdapter(config, route, fetchImpl);
+    const request = parsedRequest({
+      modelId: "gemini-web/pro",
+      context: {
+        messages: [{
+          role: "toolResult",
+          toolCallId: "call_1",
+          toolName: "read_file",
+          content: "file contents",
+          isError: false,
+          timestamp: 2,
+        }],
+      },
+      _providerState: {
+        geminiWeb: {
+          conversationUrl: "https://gemini.google.com/app/follow_123",
+          model: "pro",
+        },
+      },
+    });
+    const events: AdapterEvent[] = [];
+    await adapter.runTurn(request, { headers: new Headers() }, event => events.push(event));
+
+    expect(submitted).toMatchObject({
+      provider: "gemini",
+      model: "pro",
+      new_chat: false,
+      conversation_url: "https://gemini.google.com/app/follow_123",
+    });
+    expect(String(submitted!.prompt)).toContain("TOOL RESULT read_file (call_1)");
+    expect(events.find(event => event.type === "text_delta")).toMatchObject({
+      type: "text_delta",
+      text: "FOLLOWUP_OK",
+    });
+  });
+
+  test("cancels the durable relay job when the Codex request aborts", async () => {
+  process.env.OMA_RELAY_TOKEN = "test-relay-token";
+  const controller = new AbortController();
+  let cancelledJob: string | undefined;
+  let taskId = "";
+
+  const fetchImpl = (async (input: RequestInfo | URL, init?: RequestInit) => {
+    const url = String(input);
+    if (url.endsWith("/jobs/submit")) {
+      const payload = JSON.parse(String(init?.body || "{}"));
+      taskId = String(payload.task_id);
+      setTimeout(() => controller.abort(), 0);
+      return Response.json({ job_id: "job_abort" });
+    }
+    if (url.includes("/jobs/wait?")) {
+      await new Promise<void>((_resolve, reject) => {
+        if (init?.signal?.aborted) {
+          reject(new DOMException("aborted", "AbortError"));
+          return;
+        }
+        init?.signal?.addEventListener(
+          "abort",
+          () => reject(new DOMException("aborted", "AbortError")),
+          { once: true },
+        );
+      });
+      throw new Error("unreachable");
+    }
+    if (url.endsWith("/jobs/cancel")) {
+      const payload = JSON.parse(String(init?.body || "{}"));
+      cancelledJob = String(payload.job_id);
+      return Response.json({ ok: true, task_id: taskId });
+    }
+    throw new Error("unexpected fetch " + url);
+  }) as typeof fetch;
+
+  const config = { ...defaultConfig(), geminiWebEnabled: true };
+  const route = requireGeminiWebModelRoute("gemini-web/flash", config);
+  const adapter = createGeminiWebAdapter(config, route, fetchImpl);
+
+  await expect(
+    adapter.runTurn(
+      parsedRequest(),
+      { headers: new Headers(), abortSignal: controller.signal },
+      () => {},
+    ),
+  ).rejects.toThrow();
+
+  expect(cancelledJob).toBe("job_abort");
+  });
+});
