+
+function config() {
+  const value = defaultConfig("full");
+  value.geminiWebEnabled = true;
+  value.geminiRelayBase = "http://127.0.0.1:8765";
+  value.geminiRelayTokenFile = "C:\\sentra\\relay-token";
+  return value;
+}
+
+function request(body: Record<string, unknown>): Request {
+  return new Request("http://127.0.0.1:17841/v1/responses", {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+}
+
+const nativeCatalog = {
+  models: [{
+    slug: "gpt-native",
