+  // Hash only a bounded recent text window. Keep every observed user MID for safe baselining.
+  const recentUsers = [...userTextCandidates.entries()].slice(-50).reverse();
+  let hashedTextBytes = 0;
+  for (const [messageId, candidate] of recentUsers) {
+    const textBytes = new TextEncoder().encode(candidate.text).byteLength;
+    if (hashedTextBytes + textBytes > 2_000_000) continue;
+    hashedTextBytes += textBytes;
+    mediaMessages.set(messageId, { message_id: messageId,
+      ...(candidate.requestId ? { request_id: candidate.requestId } : {}), text_sha256: await sha256(candidate.text) });
