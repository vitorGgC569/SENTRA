+        const payload = JSON.parse(String(init?.body || "{}"));
+        taskId = String(payload.task_id);
+        return Response.json({ job_id: "job_bad_tool" });
+      }
+      if (url.includes("/jobs/wait?")) {
+        return Response.json({
+          job_id: "job_bad_tool",
+          task_id: taskId,
+          status: "COMPLETED",
+          result: answer,
+          conversation_url: "https://gemini.google.com/app/bad_123",
+          conversation_id: "bad_123",
+        });
+      }
+      if (url.endsWith("/jobs/ack")) return Response.json({ ok: true });
+      throw new Error("unexpected fetch " + url);
+    }) as typeof fetch;
+
+    const config = { ...defaultConfig(), geminiWebEnabled: true };
+    const route = requireGeminiWebModelRoute("gemini-web/flash", config);
+    const adapter = createGeminiWebAdapter(config, route, fetchImpl);
+    const request = parsedRequest({
+      context: {
+        messages: [{ role: "user", content: "do something", timestamp: 1 }],
+        tools: [{
+          name: "safe_tool",
+          description: "Only allowed tool",
+          parameters: { type: "object", additionalProperties: false },
+        }],
+      },
+    });
+
+    await expect(
+      adapter.runTurn(request, { headers: new Headers() }, () => {}),
+    ).rejects.toThrow("unavailable tool");
+  });
+
+  test("continues the exact Gemini conversation after a Codex tool result", async () => {
+    let taskId = "";
+    let submitted: Record<string, unknown> | undefined;
+    const fetchImpl = (async (input: RequestInfo | URL, init?: RequestInit) => {
+      const url = String(input);
+      if (url.endsWith("/jobs/submit")) {
+        submitted = JSON.parse(String(init?.body || "{}"));
+        taskId = String(submitted!.task_id);
+        return Response.json({ job_id: "job_follow" });
+      }
+      if (url.includes("/jobs/wait?")) {
+        return Response.json({
+          job_id: "job_follow",
+          task_id: taskId,
+          status: "COMPLETED",
+          result: "FOLLOWUP_OK",
+          conversation_url: "https://gemini.google.com/app/follow_123",
+          conversation_id: "follow_123",
