+        endTurn: true,
+        providerState: parsed._providerState,
+      });
+    },
+  });
+
+  const second = await responseRequest(request({
+    model: "gemini-web/flash",
+    stream: false,
+    store: false,
+    previous_response_id: firstBody.id,
+    input: [{
