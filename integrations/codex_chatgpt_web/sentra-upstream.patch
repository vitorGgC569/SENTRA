--- /dev/null
+++ b/src/gemini-web-models.ts
@@ -0,0 +1,54 @@
+import type { AppConfig } from "./config";
+
+export const GEMINI_WEB_MODEL_PREFIX = "gemini-web/";
+export type GeminiWebMode = "flash-lite" | "flash" | "pro";
+
+export interface GeminiWebModelRoute {
+  slug: string;
+  displayName: string;
+  description: string;
+  mode: GeminiWebMode;
+}
+
+export const GEMINI_WEB_MODEL_ROUTES: readonly GeminiWebModelRoute[] = [
+  {
+    slug: "gemini-web/flash-lite",
+    displayName: "Gemini Web — Flash-Lite",
+    description: "Gemini Web Flash-Lite through the SENTRA durable Edge relay.",
+    mode: "flash-lite",
+  },
+  {
+    slug: "gemini-web/flash",
+    displayName: "Gemini Web — Flash",
+    description: "Gemini Web Flash through the SENTRA durable Edge relay.",
+    mode: "flash",
+  },
+  {
+    slug: "gemini-web/pro",
+    displayName: "Gemini Web — Pro",
+    description: "Gemini Web Pro through the SENTRA durable Edge relay.",
+    mode: "pro",
+  },
+];
+
+export function isGeminiWebModelSlug(modelId: string): boolean {
+  return modelId.startsWith(GEMINI_WEB_MODEL_PREFIX);
+}
+
+export function availableGeminiWebModelRoutes(
+  config: Pick<AppConfig, "geminiWebEnabled">,
+): readonly GeminiWebModelRoute[] {
+  return config.geminiWebEnabled ? GEMINI_WEB_MODEL_ROUTES : [];
+}
+
+export function requireGeminiWebModelRoute(
+  modelId: string,
+  config: Pick<AppConfig, "geminiWebEnabled">,
+): GeminiWebModelRoute {
+  if (!config.geminiWebEnabled) {
+    throw new Error("Gemini Web is disabled in the local runtime configuration");
+  }
+  const route = GEMINI_WEB_MODEL_ROUTES.find(candidate => candidate.slug === modelId);
+  if (!route) throw new Error(`Unknown Gemini Web model: ${modelId}`);
+  return route;
+}
