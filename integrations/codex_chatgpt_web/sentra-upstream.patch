+test("saved URLs admit only exact ChatGPT conversations", () => {
+  assert.equal(savedChatUrl(url), url);
+  assert.equal(savedChatUrl(url.replace("/c/", "/g/g-p-project/c/")), url.replace("/c/", "/g/g-p-project/c/"));
+  for (const invalid of ["https://chatgpt.com/?temporary-chat=true", "https://chatgpt.com/", url + "?temporary-chat=true",
+    url + "#other", url.replace("chatgpt.com", "evil.com"), url.replace("https:", "http:"),
