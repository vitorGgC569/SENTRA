+// SENTRA_BROWSER_DURABLE_V2_BEGIN
+type SentraDocument = { document_id: string; identity_epoch: string; surface_id: string };
+type SentraObservedMessage = { message_id: string; request_id: string; text: string };
+type SentraMediaMessage = { message_id: string; request_id?: string; text_sha256?: string };
+type SentraMediaAssistant = { message_id: string; parent_id?: string; status?: string };
+export type SentraPageEvidence = SentraDocument & {
+  conversation_id: string | null; state: string; messages: SentraObservedMessage[];
+  assistants: { message_id: string; request_id?: string; parent_id?: string; text: string }[];
+  media_messages: SentraMediaMessage[];
+  media_assistants: SentraMediaAssistant[];
+};
+
+const sentraEvidenceId = (value: unknown): value is string => (
+  typeof value === "string" && /^[A-Za-z0-9_-]{8,160}$/.test(value)
+);
+
+/** Projects bounded identity/text metadata from messages on a previously verified committed Fiber path. */
+export function projectSentraCommittedMessages(values: readonly unknown[]): Pick<SentraPageEvidence,
+  "messages" | "assistants" | "media_messages" | "media_assistants"> {
+  const messages = new Map<string, SentraObservedMessage>();
+  const requests = new Map<string, string>();
+  const assistants = new Map<string, { message_id: string; request_id?: string; parent_id?: string; text: string }>();
+  const mediaMessages = new Map<string, SentraMediaMessage>();
+  const mediaAssistants = new Map<string, SentraMediaAssistant>();
+  const boundedValues = values.slice(0, 1200);
+  for (const message of boundedValues) {
+    if (!message || typeof message !== "object" || Array.isArray(message)) continue;
+    const record = message as Record<string, any>;
+    const role = record.author?.role;
+    if (!sentraEvidenceId(record.id) || (role !== "user" && role !== "assistant")) continue;
+    const parts = record.content?.parts;
+    if (!Array.isArray(parts)) continue;
+    const textParts = parts.filter((part: unknown): part is string => typeof part === "string");
+    const text = textParts.join("\n");
+    if (role === "assistant") {
+      const candidateMetadata: SentraMediaAssistant = {
+        message_id: record.id,
+        ...(sentraEvidenceId(record.parent_id) ? { parent_id: record.parent_id } : {}),
+        ...(typeof record.status === "string" ? { status: record.status.slice(0, 64) } : {}),
+      };
+      const previousMetadata = mediaAssistants.get(record.id);
+      if (previousMetadata && JSON.stringify(previousMetadata) !== JSON.stringify(candidateMetadata)) {
+        throw new Error("sentra_media_assistant_conflict");
+      }
+      mediaAssistants.set(record.id, candidateMetadata);
+      if (text.length > 2_000_000) throw new Error("sentra_message_too_large");
+      if (parts.some((part: unknown) => typeof part !== "string")) continue;
+      const candidate = { message_id: record.id, text,
+        ...(sentraEvidenceId(record.metadata?.request_id) ? { request_id: record.metadata.request_id } : {}),
+        ...(sentraEvidenceId(record.parent_id) ? { parent_id: record.parent_id } : {}) };
+      const prior = assistants.get(record.id);
+      if (prior && JSON.stringify(prior) !== JSON.stringify(candidate)) throw new Error("sentra_assistant_conflict");
+      assistants.set(record.id, candidate);
+      continue;
+    }
+    if (text.length > 2_000_000) throw new Error("sentra_message_too_large");
+    const requestId = sentraEvidenceId(record.metadata?.request_id) ? record.metadata.request_id : undefined;
+    const mediaMessage: SentraMediaMessage = {
+      message_id: record.id,
+      ...(requestId ? { request_id: requestId } : {}),
+      text_sha256: createHash("sha256").update(text, "utf8").digest("hex"),
+    };
+    const previousMediaMessage = mediaMessages.get(record.id);
+    if (previousMediaMessage && JSON.stringify(previousMediaMessage) !== JSON.stringify(mediaMessage)) {
+      throw new Error("sentra_media_message_conflict");
+    }
+    mediaMessages.set(record.id, mediaMessage);
+    if (parts.some((part: unknown) => typeof part !== "string")) continue;
+    if (!requestId) continue;
+    const observed = { message_id: record.id, request_id: requestId, text };
+    const prior = messages.get(record.id), owner = requests.get(requestId);
+    if ((prior && (prior.request_id !== requestId || prior.text !== text)) || (owner && owner !== record.id)) {
+      throw new Error("sentra_message_conflict");
+    }
+    messages.set(record.id, observed); requests.set(requestId, record.id);
+  }
+  return {
+    messages: [...messages.values()],
+    assistants: [...assistants.values()],
+    media_messages: [...mediaMessages.values()],
+    media_assistants: [...mediaAssistants.values()],
+  };
+}
+
+/** Runs in the owned page, reads committed React IDs/content only, never account/session data. */
+export async function readSentraPageEvidence(): Promise<SentraPageEvidence> {
+  const scope = globalThis as typeof globalThis & { __SENTRA_WEB_DOCUMENT__?: SentraDocument };
+  const identity = scope.__SENTRA_WEB_DOCUMENT__;
+  if (!identity || !/^[a-f0-9]{32}$/.test(identity.document_id)
+    || !/^[a-f0-9]{32}$/.test(identity.identity_epoch) || !identity.surface_id
