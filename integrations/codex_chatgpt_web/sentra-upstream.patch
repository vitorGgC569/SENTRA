+    expect(compiled.text).not.toContain("attached Codex Native tools");
+    expect(compiled.text).toContain("attached SENTRA tools");
+    expect(compiled.text).toContain("first call sentra_session_open");
+    expect(compiled.text).toContain("never invent a session_token");
+    expect(compiled.text).toContain("For tools where session_token is optional, omit it");
+    expect(compiled.text).toContain("do not replay a mutation whose outcome is unknown");
+    expect(compiled.text).toContain("do not evade an approval or denial by changing sessions");
+    expect(compiled.text).toContain("Do not claim a safety or permission block without an explicit tool result");
+    // A retained conversation resume gets the same contract instead of reusing an old native token.
+    parsed.context.messages.push({ role: "assistant", content: [{ type: "text", text: "previous result" }], timestamp: 3 });
+    const resumed = compileChatGptWebPrompt(parsed, capabilities, brokerToken, { sentraManagedTools: true });
+    expect(resumed.text).not.toContain(brokerToken);
+    expect(resumed.text).toContain("conversation-session rules above");
+  }
 });
 
