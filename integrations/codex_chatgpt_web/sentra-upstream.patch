+  const selectedIds = new Set(selectedAssistantMessageIds);
+  const replies = current.media_assistants.filter(message => message.status === "finished_successfully"
+    && message.parent_id === userMessageId
+    && selectedIds.has(message.message_id));
+  if (replies.length !== 1) return;
+  const reply = replies[0]!;
+  return { conversationId: current.conversation_id, messageId: reply.message_id };
