+import { expect, test } from "bun:test";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { defaultConfig, loadConfig, saveConfig } from "../src/config";
+import { augmentNativeModelCatalog } from "../src/model-catalog";
+import { responseRequest } from "../src/server";
+import type { ProviderAdapter } from "../src/adapters/base";
+
+function config() {
+  const value = defaultConfig("full");
+  value.geminiWebEnabled = true;
+  value.geminiRelayBase = "http://127.0.0.1:8765";
+  value.geminiRelayTokenFile = "C:\\sentra\\relay-token";
+  return value;
+}
+
+function request(body: Record<string, unknown>): Request {
+  return new Request("http://127.0.0.1:17841/v1/responses", {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+}
+
+const nativeCatalog = {
+  models: [{
+    slug: "gpt-native",
+    display_name: "Native",
+    description: "Native model",
+    visibility: "list",
+    supported_in_api: true,
+    priority: 1,
+    multi_agent_version: "v1",
+    tool_mode: "function",
+    supported_reasoning_levels: [{
+      effort: "low",
+      description: "Low",
+    }],
+    default_reasoning_level: "low",
+    context_window: 200000,
+    max_context_window: 200000,
+  }],
+};
+
+test("SENTRA-managed relay token authority overrides persisted config", () => {
+  const previousHome = process.env.CODEX_CHATGPT_WEB_HOME;
+  const previousGateway = process.env.SENTRA_WEB_GATEWAY_URL;
+  const previousRelayToken = process.env.SENTRA_BROWSER_RELAY_TOKEN_FILE;
+  const root = mkdtempSync(join(tmpdir(), "sentra-gemini-config-"));
+  try {
+    process.env.CODEX_CHATGPT_WEB_HOME = root;
+    process.env.SENTRA_WEB_GATEWAY_URL = "http://127.0.0.1:17842/v1";
+    const managedToken = join(root, "managed-relay-token");
+    process.env.SENTRA_BROWSER_RELAY_TOKEN_FILE = managedToken;
+
+    const persisted = defaultConfig("browser-only");
+    persisted.geminiWebEnabled = true;
+    persisted.geminiRelayTokenFile = join(root, "stale-relay-token");
+    saveConfig(persisted);
+
+    expect(loadConfig().geminiRelayTokenFile).toBe(managedToken);
+  } finally {
+    if (previousHome === undefined) delete process.env.CODEX_CHATGPT_WEB_HOME;
+    else process.env.CODEX_CHATGPT_WEB_HOME = previousHome;
+    if (previousGateway === undefined) delete process.env.SENTRA_WEB_GATEWAY_URL;
+    else process.env.SENTRA_WEB_GATEWAY_URL = previousGateway;
+    if (previousRelayToken === undefined) delete process.env.SENTRA_BROWSER_RELAY_TOKEN_FILE;
+    else process.env.SENTRA_BROWSER_RELAY_TOKEN_FILE = previousRelayToken;
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+test("Gemini Web models are opt-in catalog rows", () => {
+  const disabled = defaultConfig("full");
+  expect(
+    (augmentNativeModelCatalog(nativeCatalog, disabled).models as Array<{ slug: string }>)
+      .some(model => model.slug.startsWith("gemini-web/")),
+  ).toBe(false);
+
+  const enabled = config();
+  const slugs = (augmentNativeModelCatalog(nativeCatalog, enabled).models as Array<{ slug: string }>)
+    .map(model => model.slug);
+  expect(slugs).toContain("gemini-web/flash-lite");
+  expect(slugs).toContain("gemini-web/flash");
+  expect(slugs).toContain("gemini-web/pro");
+});
+
+test("Gemini Web response route returns text and preserves private continuation state", async () => {
+  const firstFactory = (): ProviderAdapter => ({
+    name: "gemini-test-first",
+    async runTurn(parsed, _incoming, emit) {
+      expect(parsed.modelId).toBe("gemini-web/flash");
+      expect(parsed._providerState).toBeUndefined();
+      emit({ type: "text_delta", text: "GEMINI_FIRST", phase: "final_answer" });
+      emit({
+        type: "done",
+        endTurn: true,
+        providerState: {
+          geminiWeb: {
+            conversationUrl: "https://gemini.google.com/app/abc_DEF-123",
+            mode: "flash",
+          },
+        },
+      });
+    },
+  });
+
+  const first = await responseRequest(request({
+    model: "gemini-web/flash",
+    stream: false,
+    store: false,
+    input: [{
+      type: "message",
+      role: "user",
+      content: [{ type: "input_text", text: "hello" }],
+    }],
+  }), config(), undefined, {
+    geminiAdapterFactory: firstFactory,
+  });
+  expect(first.status).toBe(200);
+  const firstBody = await first.json() as {
+    id: string;
+    output: Array<{ type?: string; content?: Array<{ text?: string }> }>;
+  };
+  expect(JSON.stringify(firstBody.output)).toContain("GEMINI_FIRST");
+
+  const secondFactory = (): ProviderAdapter => ({
+    name: "gemini-test-second",
+    async runTurn(parsed, _incoming, emit) {
+      expect(parsed._providerState?.geminiWeb).toEqual({
+        conversationUrl: "https://gemini.google.com/app/abc_DEF-123",
+        mode: "flash",
+      });
+      emit({ type: "text_delta", text: "GEMINI_SECOND", phase: "final_answer" });
+      emit({
+        type: "done",
+        endTurn: true,
+        providerState: parsed._providerState,
+      });
+    },
+  });
+
+  const second = await responseRequest(request({
+    model: "gemini-web/flash",
+    stream: false,
+    store: false,
+    previous_response_id: firstBody.id,
+    input: [{
+      type: "message",
+      role: "user",
+      content: [{ type: "input_text", text: "continue" }],
+    }],
+  }), config(), undefined, {
+    geminiAdapterFactory: secondFactory,
+  });
+  expect(second.status).toBe(200);
+  const secondBody = await second.json() as { output: unknown[] };
+  expect(JSON.stringify(secondBody.output)).toContain("GEMINI_SECOND");
+});
+
+test("Gemini Web tool call is surfaced to native Codex", async () => {
+  const factory = (): ProviderAdapter => ({
+    name: "gemini-test-tool",
+    async runTurn(parsed, _incoming, emit) {
+      expect(parsed.context.tools?.[0]?.name).toBe("weather");
+      emit({ type: "tool_call_start", id: "call_weather", name: "weather" });
+      emit({ type: "tool_call_delta", arguments: JSON.stringify({ city: "Tokyo" }) });
+      emit({ type: "tool_call_end" });
+      emit({
+        type: "done",
+        endTurn: true,
+        providerState: {
+          geminiWeb: {
+            conversationUrl: "https://gemini.google.com/app/tool_123",
+            mode: "pro",
+          },
+        },
+      });
+    },
+  });
+
+  const response = await responseRequest(request({
+    model: "gemini-web/pro",
+    stream: false,
+    store: false,
+    tools: [{
+      type: "function",
+      name: "weather",
+      description: "Get weather",
+      strict: false,
+      parameters: {
+        type: "object",
+        properties: { city: { type: "string" } },
+        required: ["city"],
+      },
+    }],
+    input: [{
+      type: "message",
+      role: "user",
+      content: [{ type: "input_text", text: "weather?" }],
+    }],
+  }), config(), undefined, {
+    geminiAdapterFactory: factory,
+  });
+  expect(response.status).toBe(200);
+  const body = await response.json() as { output: Array<Record<string, unknown>> };
+  expect(body.output).toContainEqual(expect.objectContaining({
+    type: "function_call",
+    call_id: "call_weather",
+    name: "weather",
+    arguments: JSON.stringify({ city: "Tokyo" }),
+  }));
+});
