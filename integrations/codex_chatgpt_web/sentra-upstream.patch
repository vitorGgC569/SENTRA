+
+  const first = await responseRequest(request({
+    model: "gemini-web/flash",
+    stream: false,
+    store: false,
+    input: [{
+      type: "message",
+      role: "user",
+      content: [{ type: "input_text", text: "hello" }],
+    }],
+  }), config(), undefined, {
+    geminiAdapterFactory: firstFactory,
+  });
+  expect(first.status).toBe(200);
