new file mode 100644
index 0000000000000000000000000000000000000000..e936cc52487464e402ccef4a949661e460affb9d
--- /dev/null
+++ b/launcher/electron/saved-conversations.cjs
@@ -0,0 +1,83 @@
+const fs = require("node:fs");
+const { writePrivateFileAtomic } = require("./atomic-file.cjs");
+
+// This is only a browser routing index. SENTRA's protected journal remains the
+// authority for messages, tool receipts and unresolved submissions.
+function savedChatUrl(value) {
+  if (typeof value !== "string") return null;
+  try {
+    const url = new URL(value);
+    if (url.origin !== "https://chatgpt.com" || url.username || url.password
+      || url.search || url.hash
+      || !/^\/(?:g\/[a-zA-Z0-9_-]+\/)?c\/[a-f0-9-]{36}$/.test(url.pathname)) return null;
+    return url.href;
+  } catch { return null; }
+}
+
+class SavedConversations {
+  constructor(filePath, profile, partition, storage) {
+    this.filePath = filePath;
+    this.profile = profile;
+    this.partition = partition;
+    this.storage = storage;
+    this.entries = new Map();
+    if (!fs.existsSync(filePath)) return;
+    try {
+      const bytes = fs.readFileSync(filePath);
+      if (bytes.length > 16 * 1024 * 1024) throw new Error("index too large");
+      const data = JSON.parse(this.storage.decryptString(bytes));
+      if (data.version !== 1 || data.profile !== profile || data.partition !== partition
+        || !Array.isArray(data.entries)) throw new Error("profile mismatch");
+      for (const entry of data.entries) {
+        if (!/^[a-f0-9]{64}$/.test(entry.key) || !savedChatUrl(entry.url)
+          || !(entry.connectorIdentity === undefined || typeof entry.connectorIdentity === "string")
+          || this.entries.has(entry.key)) throw new Error("invalid binding");
+        this.entries.set(entry.key, entry);
+      }
+    } catch {
+      // Never silently replace an unreadable index with fresh chats.
+      throw new Error("Saved ChatGPT conversation index could not be opened");
+    }
+  }
+
+  get(key, connectorIdentity) {
+    const entry = this.entries.get(key);
+    if (!entry) return null;
+    if (entry.connectorIdentity !== connectorIdentity) {
+      throw new Error("Saved ChatGPT conversation connector identity changed");
+    }
+    return { ...entry };
+  }
+
+  set(key, connectorIdentity, url) {
+    const validated = savedChatUrl(url);
+    if (!/^[a-f0-9]{64}$/.test(key) || !validated) {
+      throw new Error("ChatGPT did not commit a saved conversation URL");
+    }
+    const previous = this.get(key, connectorIdentity);
+    if (previous && previous.url !== validated) throw new Error("Saved ChatGPT conversation changed unexpectedly");
+    const next = new Map(this.entries);
+    next.set(key, { key, connectorIdentity, url: validated });
+    this.commit(next);
+  }
+
+  delete(key) {
+    if (!this.entries.has(key)) return false;
+    const next = new Map(this.entries);
+    next.delete(key);
+    this.commit(next);
+    return true;
+  }
+
+  commit(entries) {
+    if (!this.storage?.isEncryptionAvailable()) {
+      throw new Error("Private storage for saved ChatGPT conversations is unavailable");
+    }
+    const payload = JSON.stringify({ version: 1, profile: this.profile,
+      partition: this.partition, entries: [...entries.values()] });
+    writePrivateFileAtomic(this.filePath, this.storage.encryptString(payload));
+    this.entries = entries;
+  }
+}
+
+module.exports = { SavedConversations, savedChatUrl };
