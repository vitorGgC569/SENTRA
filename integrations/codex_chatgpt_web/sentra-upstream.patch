diff --git a/src/adapters/gemini-web/index.ts b/src/adapters/gemini-web/index.ts
new file mode 100644
--- /dev/null
+++ b/src/adapters/gemini-web/index.ts
@@ -0,0 +1,507 @@
+import { randomUUID } from "node:crypto";
+import { existsSync, readFileSync } from "node:fs";
+import Ajv from "ajv";
+import type { AppConfig } from "../../config";
+import { expandUserPath } from "../../config";
+import type { GeminiWebModelRoute } from "../../gemini-web-models";
+import {
+  namespacedToolName,
+  type AdapterEvent,
+  type CodexContentPart,
+  type CodexMessage,
+  type CodexParsedRequest,
+  type CodexTool,
+  type CodexProviderContinuationState,
+  type CodexUsage,
+} from "../../types";
+import type { IncomingMeta, ProviderAdapter } from "../base";
+
+interface RelaySubmission {
+  job_id?: unknown;
+}
+
+interface RelayResult {
+  pending?: unknown;
+  job_id?: unknown;
+  task_id?: unknown;
+  status?: unknown;
+  result?: unknown;
+  error?: unknown;
+  conversation_url?: unknown;
+  conversation_id?: unknown;
+  may_have_sent?: unknown;
+  phase?: unknown;
+}
+
+interface GeminiContinuation {
+  conversationUrl: string;
+  model: string;
+}
+
+const TOOL_OPEN = "<SENTRA_TOOL_CALLS>";
+const TOOL_CLOSE = "</SENTRA_TOOL_CALLS>";
+
+function textOfContent(content: string | CodexContentPart[]): string {
+  if (typeof content === "string") return content;
+  return content
+    .map(part => part.type === "text" ? part.text : "[image attached]")
+    .join("\n");
+}
+
+function formatMessage(message: CodexMessage): string {
+  switch (message.role) {
+    case "user":
+      return "USER:\n" + textOfContent(message.content);
+    case "developer":
+      return "DEVELOPER:\n" + textOfContent(message.content);
+    case "agentMessage":
+      return "AGENT MESSAGE:\n" + textOfContent(message.content);
+    case "toolResult":
+      return [
+        `TOOL RESULT ${message.toolName || "unknown"} (${message.toolCallId}):`,
+        textOfContent(message.content),
+      ].join("\n");
+    case "assistant": {
+      const parts = message.content
+        .map(part => {
+          if (part.type === "text") return part.text;
+          if (part.type === "toolCall") {
+            return `[previous tool call ${part.name} ${JSON.stringify(part.arguments)}]`;
+          }
+          return "";
+        })
+        .filter(Boolean);
+      return "ASSISTANT:\n" + parts.join("\n");
+    }
+  }
+}
+
+function incrementalMessages(parsed: CodexParsedRequest): CodexMessage[] {
+  const messages = parsed.context.messages;
+  const continuation = geminiContinuation(parsed);
+  if (!continuation) return messages;
+  let lastAssistant = -1;
+  for (let index = messages.length - 1; index >= 0; index--) {
+    if (messages[index]?.role === "assistant") {
+      lastAssistant = index;
+      break;
+    }
+  }
+  return lastAssistant >= 0 ? messages.slice(lastAssistant + 1) : messages;
+}
+
+function toolDescriptor(tool: CodexTool): string {
+  const wire = namespacedToolName(tool.namespace, tool.name);
+  if (tool.freeform) {
+    return [
+      `- ${wire}: ${tool.description || "freeform tool"}`,
+      "  arguments: {\"input\":\"raw tool input\"}",
+    ].join("\n");
+  }
+  return [
+    `- ${wire}: ${tool.description || "tool"}`,
+    `  JSON schema: ${JSON.stringify(tool.parameters)}`,
+  ].join("\n");
+}
+
+function toolProtocol(parsed: CodexParsedRequest): string {
+  const tools = parsed.context.tools ?? [];
+  if (tools.length === 0 || parsed.options.toolChoice === "none") return "";
+  const allowed = parsed.options.toolChoice;
+  const constraint = typeof allowed === "object"
+    ? "You may call only: " + (
+      "name" in allowed
+        ? allowed.name
+        : allowed.allowedTools.join(", ")
+    )
+    : allowed === "required"
+    ? "You MUST call one listed tool before giving a final answer."
+    : "Call a tool only when it is necessary.";
+  return [
+    "",
+    "TOOLS AVAILABLE THROUGH CODEX:",
+    ...tools.map(toolDescriptor),
+    "",
+    constraint,
+    "To request one or more tools, output ONLY this envelope and no other text:",
+    `${TOOL_OPEN}{\"calls\":[{\"name\":\"tool_name\",\"arguments\":{}}]}${TOOL_CLOSE}`,
+    "Do not invent tool names. Do not claim a tool result before Codex returns it.",
+  ].join("\n");
+}
+
+function buildPrompt(parsed: CodexParsedRequest): string {
+  const sections: string[] = [];
+  if (!geminiContinuation(parsed) && parsed.context.systemPrompt?.length) {
+    sections.push("SYSTEM/DEVELOPER INSTRUCTIONS:\n" + parsed.context.systemPrompt.join("\n\n"));
+  }
+  const messages = incrementalMessages(parsed);
+  if (messages.length) sections.push(messages.map(formatMessage).join("\n\n"));
+  if (parsed.options.outputFormat) {
+    sections.push(
+      "OUTPUT CONTRACT:\nReturn content conforming to this JSON schema:\n"
+      + JSON.stringify(parsed.options.outputFormat.schema),
+    );
+  }
+  sections.push(toolProtocol(parsed));
+  return sections.filter(Boolean).join("\n\n").trim();
+}
+
+function geminiContinuation(parsed: CodexParsedRequest): GeminiContinuation | undefined {
+  const raw = parsed._providerState?.geminiWeb;
+  if (!raw || typeof raw !== "object" || Array.isArray(raw)) return undefined;
+  const conversationUrl = (raw as Record<string, unknown>).conversationUrl;
+  const model = (
+    (raw as Record<string, unknown>).model
+    ?? (raw as Record<string, unknown>).mode
+  );
+  if (
+    typeof conversationUrl !== "string"
+    || !/^https:\/\/gemini\.google\.com\/app\/[A-Za-z0-9_-]{1,256}$/.test(conversationUrl)
+  ) return undefined;
+  return {
+    conversationUrl,
+    model: typeof model === "string" ? model : "",
+  };
+}
+
+function providerState(conversationUrl: string, model: string): CodexProviderContinuationState {
+  return {
+    geminiWeb: {
+      conversationUrl,
+      model,
+    },
+  };
+}
+
+function estimatedUsage(input: string, output: string): CodexUsage {
+  const inputTokens = Math.max(1, Math.ceil(input.length / 4));
+  const outputTokens = Math.max(1, Math.ceil(output.length / 4));
+  return {
+    inputTokens,
+    outputTokens,
+    totalTokens: inputTokens + outputTokens,
+    estimated: true,
+  };
+}
+
+function imageDataUrls(parsed: CodexParsedRequest): string[] {
+  const out: string[] = [];
+  for (const message of incrementalMessages(parsed)) {
+    const content = "content" in message ? message.content : undefined;
+    if (!Array.isArray(content)) continue;
+    for (const part of content) {
+      if (part.type !== "image") continue;
+      if (!/^data:image\/(?:png|jpeg);base64,[A-Za-z0-9+/=]+$/.test(part.imageUrl)) {
+        throw new Error("Gemini Web supports only inline PNG/JPEG data URLs through the Edge relay");
+      }
+      out.push(part.imageUrl);
+    }
+  }
+  if (out.length > 2) {
+    throw new Error("Gemini Web relay accepts at most two inline images per turn");
+  }
+  return out;
+}
+
+interface ParsedGeminiToolCall {
+  id: string;
+  name: string;
+  argumentsJson: string;
+}
+
+function parseToolCalls(text: string, parsed: CodexParsedRequest): ParsedGeminiToolCall[] {
+  const start = text.indexOf(TOOL_OPEN);
+  const end = text.indexOf(TOOL_CLOSE);
+  if (start < 0 && end < 0) return [];
+  if (start < 0 || end < 0 || end <= start) {
+    throw new Error("Gemini emitted a malformed SENTRA tool envelope");
+  }
+  const before = text.slice(0, start).trim();
+  const after = text.slice(end + TOOL_CLOSE.length).trim();
+  if (before || after) {
+    throw new Error("Gemini mixed final text with a tool call; refusing ambiguous output");
+  }
+
+  let payload: unknown;
+  try {
+    payload = JSON.parse(text.slice(start + TOOL_OPEN.length, end).trim());
+  } catch {
+    throw new Error("Gemini tool envelope is not valid JSON");
+  }
+  if (!payload || typeof payload !== "object" || Array.isArray(payload)) {
+    throw new Error("Gemini tool envelope must be an object");
+  }
+  const calls = (payload as Record<string, unknown>).calls;
+  if (!Array.isArray(calls) || calls.length === 0 || calls.length > 16) {
+    throw new Error("Gemini tool envelope must contain 1..16 calls");
+  }
+  if (parsed.options.parallelToolCalls === false && calls.length > 1) {
+    throw new Error("Gemini requested parallel tools while parallel_tool_calls=false");
+  }
+  if (parsed.options.toolChoice === "none") {
+    throw new Error("Gemini requested a tool while tool_choice=none");
+  }
+
+  const tools = parsed.context.tools ?? [];
+  const ajv = new Ajv({ allErrors: true, strict: false });
+  return calls.map((value, index) => {
+    if (!value || typeof value !== "object" || Array.isArray(value)) {
+      throw new Error(`Gemini tool call ${index} must be an object`);
+    }
+    const record = value as Record<string, unknown>;
+    if (typeof record.name !== "string" || !record.name) {
+      throw new Error(`Gemini tool call ${index} is missing name`);
+    }
+    const tool = tools.find(candidate =>
+      namespacedToolName(candidate.namespace, candidate.name) === record.name
+    );
+    if (!tool) throw new Error(`Gemini requested unavailable tool ${record.name}`);
+
+    const forced = parsed.options.toolChoice;
+    if (
+      typeof forced === "object"
+      && "name" in forced
+      && forced.name !== record.name
+      && forced.name !== tool.name
+    ) {
+      throw new Error("Gemini requested a tool outside the forced tool choice");
+    }
+    if (
+      typeof forced === "object"
+      && "allowedTools" in forced
+      && !forced.allowedTools.includes(record.name)
+      && !forced.allowedTools.includes(tool.name)
+    ) {
+      throw new Error("Gemini requested a tool outside allowed_tools");
+    }
+
+    let args: unknown = record.arguments;
+    if (tool.freeform) {
+      if (typeof record.input === "string") args = { input: record.input };
+      if (
+        !args
+        || typeof args !== "object"
+        || Array.isArray(args)
+        || typeof (args as Record<string, unknown>).input !== "string"
+      ) {
+        throw new Error("Gemini freeform tool call requires arguments.input");
+      }
+    } else {
+      if (!args || typeof args !== "object" || Array.isArray(args)) {
+        throw new Error("Gemini function tool call requires an arguments object");
+      }
+      const validate = ajv.compile(tool.parameters);
+      if (!validate(args)) {
+        throw new Error(
+          `Gemini tool arguments failed schema for ${record.name}: ${ajv.errorsText(validate.errors)}`,
+        );
+      }
+    }
+    return {
+      id: "call_" + randomUUID().replaceAll("-", ""),
+      name: record.name,
+      argumentsJson: JSON.stringify(args),
+    };
+  });
+}
+
+async function relayJson(
+  url: string,
+  token: string,
+  init?: RequestInit,
+  fetchImpl: typeof fetch = globalThis.fetch,
+): Promise<Record<string, unknown>> {
+  const response = await fetchImpl(url, {
+    ...init,
+    headers: {
+      "authorization": "Bearer " + token,
+      ...(init?.body ? { "content-type": "application/json" } : {}),
+      ...(init?.headers ?? {}),
+    },
+  });
+  const text = await response.text();
+  let payload: unknown;
+  try {
+    payload = text ? JSON.parse(text) : {};
+  } catch {
+    throw new Error(`Gemini relay returned non-JSON HTTP ${response.status}`);
+  }
+  if (!response.ok) {
+    const detail = payload && typeof payload === "object"
+      ? JSON.stringify(payload)
+      : String(payload);
+    throw new Error(`Gemini relay HTTP ${response.status}: ${detail}`);
+  }
+  if (!payload || typeof payload !== "object" || Array.isArray(payload)) {
+    throw new Error("Gemini relay response must be an object");
+  }
+  return payload as Record<string, unknown>;
+}
+
+export class GeminiWebAdapter implements ProviderAdapter {
+  name = "gemini-web";
+
+  constructor(
+    private readonly config: AppConfig,
+    private readonly route: GeminiWebModelRoute,
+    private readonly fetchImpl: typeof fetch = globalThis.fetch,
+  ) {}
+
+  private token(): string {
+    const direct = process.env.OMA_RELAY_TOKEN?.trim();
+    if (direct) return direct;
+
+    const configured = this.config.geminiRelayTokenFile?.trim()
+      || process.env.SENTRA_EDGE_RELAY_TOKEN_PATH?.trim();
+    if (!configured) {
+      throw new Error(
+        "Gemini relay token is not configured; set OMA_RELAY_TOKEN or geminiRelayTokenFile",
+      );
+    }
+    const path = expandUserPath(configured);
+    if (!existsSync(path)) throw new Error(`Gemini relay token file does not exist: ${path}`);
+    const token = readFileSync(path, "utf8").trim();
+    if (!token) throw new Error("Gemini relay token file is empty");
+    return token;
+  }
+
+  async runTurn(
+    parsed: CodexParsedRequest,
+    incoming: IncomingMeta,
+    emit: (event: AdapterEvent) => void,
+  ): Promise<void> {
+    const token = this.token();
+    const continuation = geminiContinuation(parsed);
+    if (continuation?.model && continuation.model !== this.route.mode) {
+      throw new Error("Gemini continuation belongs to another model mode");
+    }
+    const prompt = buildPrompt(parsed);
+    if (prompt.length > 180_000) {
+      throw new Error("Gemini Web compiled prompt exceeds 180000 characters");
+    }
+    if (!prompt) throw new Error("Gemini Web turn has no new input");
+    const taskId = "codex-gemini-" + randomUUID().replaceAll("-", "");
+    const timeoutSec = 300;
+    const body = {
+      task_id: taskId,
+      prompt,
+      timeout_s: timeoutSec,
+      new_chat: !continuation,
+      conversation_url: continuation?.conversationUrl ?? null,
+      provider: "gemini",
+      model: this.route.mode,
+      images: imageDataUrls(parsed),
+    };
+    const submission = await relayJson(
+      this.config.geminiRelayBase + "/jobs/submit",
+      token,
+      { method: "POST", body: JSON.stringify(body), signal: incoming.abortSignal },
+      this.fetchImpl,
+    ) as RelaySubmission;
+    if (typeof submission.job_id !== "string" || !submission.job_id) {
+      throw new Error("Gemini relay did not return a job id");
+    }
+    const jobId = submission.job_id;
+    const deadline = Date.now() + timeoutSec * 1000;
+    let result: RelayResult | null = null;
+    try {
+      while (Date.now() < deadline) {
+        if (incoming.abortSignal?.aborted) {
+          throw new DOMException("Gemini Web turn cancelled", "AbortError");
+        }
+        emit({ type: "heartbeat" });
+        const waitSeconds = Math.min(5, Math.max(0.1, (deadline - Date.now()) / 1000));
+        const next = await relayJson(
+          this.config.geminiRelayBase
+            + `/jobs/wait?job_id=${encodeURIComponent(jobId)}&timeout_s=${waitSeconds}`,
+          token,
+          { signal: incoming.abortSignal },
+          this.fetchImpl,
+        ) as RelayResult;
+        if (next.pending === true) continue;
+        result = next;
+        break;
+      }
+    } catch (error) {
+      if (incoming.abortSignal?.aborted) {
+        try {
+          await relayJson(
+            this.config.geminiRelayBase + "/jobs/cancel",
+            token,
+            { method: "POST", body: JSON.stringify({ job_id: jobId }) },
+            this.fetchImpl,
+          );
+        } catch {
+          // Best-effort only. Relay lease/recovery remains authoritative.
+        }
+      }
+      throw error;
+    }
+    if (!result) throw new Error(`Gemini relay job ${jobId} timed out`);
+    if (result.job_id !== jobId || result.task_id !== taskId) {
+      throw new Error("Gemini relay response correlation mismatch");
+    }
+
+    await relayJson(
+      this.config.geminiRelayBase + "/jobs/ack",
+      token,
+      { method: "POST", body: JSON.stringify({ job_id: jobId }), signal: incoming.abortSignal },
+      this.fetchImpl,
+    );
+
+    if (result.status !== "COMPLETED") {
+      const uncertain = result.may_have_sent === true;
+      throw new Error(
+        `Gemini relay job failed${uncertain ? " after possible send" : ""}: `
+        + String(result.error ?? result.status ?? "unknown error"),
+      );
+    }
+    if (
+      typeof result.conversation_url !== "string"
+      || !/^https:\/\/gemini\.google\.com\/app\/[A-Za-z0-9_-]{1,256}$/.test(result.conversation_url)
+    ) {
+      throw new Error("Gemini relay returned an invalid conversation URL");
+    }
+    if (typeof result.result !== "string") {
+      throw new Error("Gemini relay returned a non-text result");
+    }
+
+    const terminalState = providerState(result.conversation_url, this.route.mode);
+    const usage = estimatedUsage(prompt, result.result);
+    const toolCalls = parseToolCalls(result.result.trim(), parsed);
+    if (toolCalls.length > 0) {
+      for (const toolCall of toolCalls) {
+        emit({ type: "tool_call_start", id: toolCall.id, name: toolCall.name });
+        emit({ type: "tool_call_delta", arguments: toolCall.argumentsJson });
+        emit({ type: "tool_call_end" });
+      }
+      emit({
+        type: "done",
+        stopReason: "tool_use",
+        endTurn: false,
+        usage,
+        providerState: terminalState,
+      });
+      return;
+    }
+
+    if (parsed.options.toolChoice === "required" && (parsed.context.tools?.length ?? 0) > 0) {
+      throw new Error("Gemini returned final text while tool_choice=required");
+    }
+    if (result.result) emit({ type: "text_delta", text: result.result, phase: "final_answer" });
+    emit({
+      type: "done",
+      stopReason: "stop",
+      endTurn: true,
+      usage,
+      providerState: terminalState,
+    });
+  }
+}
+export function createGeminiWebAdapter(
+  config: AppConfig,
+  route: GeminiWebModelRoute,
+  fetchImpl: typeof fetch = globalThis.fetch,
+): ProviderAdapter {
+  return new GeminiWebAdapter(config, route, fetchImpl);
+}
