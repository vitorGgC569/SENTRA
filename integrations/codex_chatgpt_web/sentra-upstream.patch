+async function generatedAssetFromDownload(
+  download: Download,
+  requestId: string,
+  identity: VerifiedAssistantMessageIdentity,
+): Promise<GeneratedAssetEvent> {
+  const rawName = download.suggestedFilename().replaceAll("\\", "/").split("/").at(-1) ?? "";
+  const safeName = rawName.normalize("NFKC").replace(/[^A-Za-z0-9._ -]/g, "_").slice(0, 128);
+  const extension = safeName.toLowerCase().split(".").at(-1);
+  const mimeType = extension === "png" ? "image/png"
+    : extension === "jpg" || extension === "jpeg" ? "image/jpeg"
+      : extension === "pdf" ? "application/pdf" : undefined;
+  if (!mimeType) throw new Error("generated_download_unsupported_filename");
+  const limit = mimeType === "application/pdf" ? MAX_GENERATED_PDF_BYTES : MAX_GENERATED_IMAGE_BYTES;
+  const stream = await download.createReadStream();
+  if (!stream) throw new Error("generated_download_stream_unavailable");
+  const chunks: Buffer[] = [];
+  let length = 0;
+  for await (const chunk of stream) {
+    const bytes = Buffer.from(chunk);
+    length += bytes.length;
+    if (length > limit) {
+      stream.destroy();
+      throw new Error("generated_download_size_limit");
+    }
+    chunks.push(bytes);
+  }
+  const bytes = Buffer.concat(chunks, length);
+  const candidate = {
+    type: "generated_asset" as const,
+    transport: GENERATED_ASSET_TRANSPORT,
+    request_id: requestId,
+    conversation_id: identity.conversationId,
+    message_id: identity.messageId,
+    filename: safeName,
+    mime_type: mimeType,
+    byte_length: bytes.length,
+    sha256: createHash("sha256").update(bytes).digest("hex"),
+    data_base64: bytes.toString("base64"),
+  };
+  return validateGeneratedAsset(candidate);
