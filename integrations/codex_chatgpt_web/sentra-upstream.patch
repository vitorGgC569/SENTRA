+const key = "a".repeat(64);
+const url = "https://chatgpt.com/c/12345678-1234-1234-1234-123456789abc";
+const encryption = {
+  isEncryptionAvailable: () => true,
+  encryptString(value) {
+    const cipher = createCipheriv("aes-256-gcm", Buffer.alloc(32, 17), Buffer.alloc(12, 4));
+    const bytes = Buffer.concat([cipher.update(value, "utf8"), cipher.final()]);
+    return Buffer.concat([cipher.getAuthTag(), bytes]);
+  },
+  decryptString(bytes) {
+    const cipher = createDecipheriv("aes-256-gcm", Buffer.alloc(32, 17), Buffer.alloc(12, 4), { authTagLength: 16 });
+    cipher.setAuthTag(bytes.subarray(0, 16));
+    return Buffer.concat([cipher.update(bytes.subarray(16)), cipher.final()]).toString("utf8");
+  },
+};
+test("managed launcher retains saved-chat preferences and the live SENTRA connector name", () => {
+  const previous = process.env.SENTRA_MANAGED_TUNNEL;
+  process.env.SENTRA_MANAGED_TUNNEL = "1";
+  try {
+    const descriptor = path.resolve(os.tmpdir(), "sentra-browser-descriptor.json");
+    const config = validateConfig({
+      version: 3, releaseVersion: "6.1.1", mode: "full", host: "127.0.0.1", port: 17841,
+      contextWindow: 256000, appName: "SENTRA tunnel", browserHost: "launcher",
+      browserHostDescriptorPath: descriptor, chromeExecutablePath: process.execPath,
+      storageStatePath: path.resolve(os.tmpdir(), "sentra-storage-state.json"),
+      brokerSocketPath: process.platform === "win32" ? "\\\\.\\pipe\\sentra-test" : "/tmp/sentra-test.sock",
+      headed: true, solAvailable: true, proAvailable: false, autoApproveToolCalls: false,
+      controlToken: "test-only-" + "a".repeat(48), runtimeCommand: [process.execPath],
+      useSavedChats: true, experimentalFreshConversationPerTurn: false,
+    }, descriptor);
+    assert.equal(config.appName, "SENTRA");
+    assert.equal(config.automaticAppName, "SENTRA");
+    assert.equal(config.useSavedChats, true);
+    assert.equal(config.experimentalFreshConversationPerTurn, false);
+  } finally {
+    if (previous === undefined) delete process.env.SENTRA_MANAGED_TUNNEL;
+    else process.env.SENTRA_MANAGED_TUNNEL = previous;
+  }
