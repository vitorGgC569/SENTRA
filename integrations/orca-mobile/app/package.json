{
  "name": "sentra-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --localhost",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform all",
    "start:lan": "expo start --lan",
    "build:terminal": "node scripts/build-terminal.mjs",
