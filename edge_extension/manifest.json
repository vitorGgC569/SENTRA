{
  "manifest_version": 3,
  "name": "OMA Browser Bridge",
  "version": "1.6.26",
  "description": "Atuador do OMA: executa operações primitivas de conversa em tabs reais e reporta ao relay local. Não decide nada.",
  "permissions": ["tabs", "storage", "alarms"],
  "options_page": "options.html",
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["selectors.js", "observer.js", "content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
