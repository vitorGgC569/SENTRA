{
  "manifest_version": 3,
  "name": "SENTRA Browser Bridge",
  "version": "1.7.0",
  "sentra_build_id": "sentra-edge-1.7.0-durable-r28",
  "description": "Ponte opcional do SENTRA para operações autorizadas em abas existentes e comunicação com o relay local.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "scripting"
  ],
  "options_page": "options.html",
  "host_permissions": [
    "<all_urls>",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "recovery-guard.js",
        "selectors.js",
        "observer.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "sentra_source_hash": "edfda4428a90710337317e26b2eba622b8b9f065460964f7adcf0f846fe4bc5f"
}
