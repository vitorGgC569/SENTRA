{
  "manifest_version": 3,
  "name": "SENTRA Browser Bridge",
  "version": "1.6.52",
  "sentra_build_id": "sentra-edge-1.6.52-durable-r27",
  "description": "Ponte opcional do SENTRA para operações autorizadas em abas existentes e comunicação com o relay local.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "scripting"
  ],
  "options_page": "options.html",
  "host_permissions": [
    "<all_urls>",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "recovery-guard.js",
        "selectors.js",
        "observer.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "sentra_source_hash": "d9bedb0f746e2249e3d56350899a4a25c936686ebc5625e8c238512870735c85"
}
