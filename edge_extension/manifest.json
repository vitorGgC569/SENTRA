{
  "manifest_version": 3,
  "name": "SENTRA Browser Bridge",
  "version": "1.6.52",
  "sentra_build_id": "sentra-edge-1.6.52-durable-r27",
  "description": "Ponte opcional do SENTRA para operações autorizadas em abas existentes e comunicação com o relay local.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "scripting"
  ],
  "options_page": "options.html",
  "host_permissions": [
    "<all_urls>",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "recovery-guard.js",
        "selectors.js",
        "observer.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "sentra_source_hash": "c49653655c7b4ad3fe8cda65138d7f0ea8cb706e628cbc2df3f71c4b6507c7e9"
}
